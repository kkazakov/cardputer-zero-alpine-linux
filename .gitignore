# build outputs
/images/
*.img
*.img.gz
*.img.xz
*.tar
build/verification-report.txt

# pinned app sources cloned by build/26-apps.sh (re-downloadable; pins in
# build/INPUTS.md and the script)
build/apps-src/

# built app packages (build/build-app-package.sh output)
build/packages/
build/.pkg-*

# secrets — user wifi credentials, NEVER commit (see AGENTS.md)
build/wifi-secret/

# field diagnostics captured from devices (session data, not build inputs)
build/cpz-diag-field.txt
build/cpz-keys.bin

# upstream binary blobs — re-downloadable, pinned by hash in build/INPUTS.md
vendor/*.img.xz

# reference-only clones (upstream pinned in build/INPUTS.md)
vendor/pi-gen/
vendor/**/images/

# editor / os noise
.DS_Store
*~
.vscode/
# local working clone (user reference checkout — vendor it deliberately if wanted)
launcher/

# release staging (the ZIP itself is under images/, already ignored)
build/release-stage/

# local machine/network cheat sheet (never committed)
local-setup.md
