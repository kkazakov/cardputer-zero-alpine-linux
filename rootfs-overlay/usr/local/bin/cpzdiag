#!/bin/sh
# /usr/local/bin/cpzdiag — CPZ-Alpine field diagnostics (v2)
#
# Typed on the device console (short name: SYM-free, no slashes needed).
# Everything lands in ONE report on the FAT boot partition, readable on
# any desktop after pulling the card:
#
#   cpzdiag
#
# v2 changes (v1 died: the image had no /boot dir, so localmount never
# mounted it and the report could not be written):
#   - creates /boot and mounts the CPZBOOT partition itself if needed,
#     falls back to /root only if even that fails
#   - full i2c dumps of BOTH chips, taken twice 5s apart — whatever
#     cycles the keyboard LEDs will show up as changing registers
#   - records 20s of raw keypad events while you press the SYM-layer
#     keys: this captures the true key matrix, no transcription needed

modprobe i2c-dev 2>/dev/null

OUT=/boot/cpz-diag.txt
# v0.7: OpenRC (no longer fooled by /.dockerenv) mounts the real FAT at
# /boot via fstab. Verify it IS a mount — do not trust a plain writable
# dir (v0.6 wrote the report into the ext4's empty /boot and the FAT
# looked empty from the desktop).
if ! mountpoint /boot >/dev/null 2>&1; then
    DEV=$(blkid 2>/dev/null | sed -n 's/^\([^:]*\):.*LABEL="CPZBOOT".*/\1/p' | head -1)
    [ -n "$DEV" ] && { mkdir -p /boot; mount -t vfat -o rw "$DEV" /boot 2>/dev/null; }
fi
touch "$OUT" 2>/dev/null || OUT=/root/cpz-diag.txt

section() { echo "" >> "$OUT"; echo "===== $1 =====" >> "$OUT"; }

{
    echo "CPZ-Alpine diagnostics v2 — $(date)"
    echo "release: $(cat /etc/cpz-release 2>/dev/null | tr '\n' ' ')"
    echo "output: $OUT"
} > "$OUT"

section "uname / cmdline"
uname -a >> "$OUT" 2>&1
cat /proc/cmdline >> "$OUT" 2>&1

section "runlevel services"
rc-status -a >> "$OUT" 2>&1

section "dmesg (full)"
dmesg >> "$OUT" 2>&1

section "loaded modules"
lsmod >> "$OUT" 2>&1

section "power supply (battery gauge)"
for d in /sys/class/power_supply/*/; do
    echo "--- $d" >> "$OUT"
    for p in capacity status voltage_now current_now power_now temp \
             charge_full charge_full_design cycle_count health; do
        v=$(cat "$d$p" 2>/dev/null) && echo "$p = $v" >> "$OUT"
    done
done
ls -la /sys/class/power_supply/ >> "$OUT" 2>&1

section "thermal"
ls -la /sys/class/thermal/ >> "$OUT" 2>&1
cat /sys/class/thermal/thermal_zone0/temp >> "$OUT" 2>&1

section "network devices"
ls -la /sys/class/net/ >> "$OUT" 2>&1
ip a >> "$OUT" 2>&1

section "wifi association state"
cat /etc/network/interfaces >> "$OUT" 2>&1
rc-service wpa_supplicant status >> "$OUT" 2>&1
iw dev wlan0 link >> "$OUT" 2>&1
# wpa conf WITHOUT the psk lines
grep -v "psk" /etc/wpa_supplicant/wpa_supplicant.conf >> "$OUT" 2>&1

section "gpiochips (expander gpio)"
ls -la /sys/class/gpio/ >> "$OUT" 2>&1
for g in /sys/class/gpio/gpiochip*; do
    [ -e "$g" ] && echo "$g: label=$(cat "$g/label" 2>/dev/null) ngpio=$(cat "$g/ngpio" 2>/dev/null)" >> "$OUT"
done

section "expander LED engine regs (forced access)"
i2cget -f -y 1 0x4f 0x24 >> "$OUT" 2>&1
i2cdump -f -y 1 0x4f 0x30 >> "$OUT" 2>&1

section "leds class (keyboard LEDs)"
ls -la /sys/class/leds/ >> "$OUT" 2>&1
for l in /sys/class/leds/*/brightness; do
    [ -e "$l" ] && echo "$l = $(cat "$l" 2>/dev/null)" >> "$OUT"
done

section "pwm class (expander PWM channels)"
ls -la /sys/class/pwm/ >> "$OUT" 2>&1
for c in /sys/class/pwm/pwmchip*; do
    [ -e "$c" ] && echo "$c: npwm=$(cat "$c/npwm" 2>/dev/null)" >> "$OUT"
done

section "expander gpio (m5ioe1)"
ls /sys/bus/i2c/drivers/ >> "$OUT" 2>&1
find /sys/bus/i2c/devices/ -maxdepth 1 -name "*004f*" >> "$OUT" 2>&1
ls -la /sys/bus/i2c/devices/004f/ 2>/dev/null >> "$OUT" 2>&1

section "framebuffers"
for f in /sys/class/graphics/fb*; do
    echo "--- $f: $(cat "$f/name" 2>/dev/null)" >> "$OUT"
done

section "input devices"
EV=""
for d in /sys/class/input/event*; do
    n=$(cat "$d/device/name" 2>/dev/null)
    echo "--- $d: $n" >> "$OUT"
    case "$n" in
        *tca8418*|*keypad*|*Keyboard*) EV="/dev/input/${d##*/}" ;;
    esac
done
# fallback: first event device with actual key capabilities
if [ -z "$EV" ]; then
    for d in /sys/class/input/event*; do
        if [ -s "$d/device/capabilities/key" ]; then
            EV="/dev/input/${d##*/}"
            break
        fi
    done
fi

section "i2c buses"
ls -la /dev/i2c* >> "$OUT" 2>&1
i2cdetect -y 1 >> "$OUT" 2>&1

section "m5ioe1 expander dump 0x4f (snapshot 1)"
i2cdump -y 1 0x4f >> "$OUT" 2>&1

section "tca8418 keypad dump 0x34"
i2cdump -y 1 0x34 >> "$OUT" 2>&1

section "SYM KEY SWEEP — 20 seconds, press keys NOW"
echo ""
echo "Hold SYM and press EVERY key that has a small symbol printed on"
echo "it, left to right, top to bottom. 20 seconds..."
echo ""
if [ -n "$EV" ] && [ -c "$EV" ]; then
    echo "recording from: $EV"
    echo "keypad events: $EV" >> "$OUT"
    # v1 used GNU od flags busybox od rejects; v2 used `timeout 20
    # hexdump -C` which also returned instantly (both errors went to the
    # report, invisible on the console). This version cannot fail the
    # same way: raw blocking dd in the background, killed after 20s,
    # binary to a SEPARATE file so the text report stays readable.
    # 24 bytes = struct input_event on aarch64 (timeval 16 + type 2 +
    # code 2 + value 4). MSC_SCAN events carry the raw scan codes.
    rm -f "${OUT%/*}/cpz-keys.bin"
    dd if="$EV" of="${OUT%/*}/cpz-keys.bin" bs=24 count=400 2>>"$OUT" &
    DDPID=$!
    i=0
    while [ $i -lt 40 ]; do sleep 0.5; i=$((i + 1)); done
    kill $DDPID 2>/dev/null
    sync
    BYTES=$(wc -c < "${OUT%/*}/cpz-keys.bin" 2>/dev/null || echo 0)
    echo "captured $BYTES bytes -> ${OUT%/*}/cpz-keys.bin"
    echo "captured $BYTES bytes" >> "$OUT"
    if [ "$BYTES" -gt 0 ]; then
        echo "Good. If you pressed all SYM keys, the matrix is captured."
    else
        echo "WARNING: 0 bytes captured — no events reached $EV"
    fi
else
    echo "NO keypad event device found"
    echo "NO keypad event device found" >> "$OUT"
fi

section "m5ioe1 expander dump 0x4f (snapshot 2, after sweep)"
i2cdump -y 1 0x4f >> "$OUT" 2>&1

section "console keymap (kernel)"
dumpkeys >> "$OUT" 2>&1

sync
echo ""
echo "done — report: $OUT"
echo "If that is /boot: power off, pull the card, read cpz-diag.txt"
echo "from the CPZBOOT partition on the desktop."