#!/bin/sh
# /usr/local/bin/cpz-save — snapshot user state to the persistent data
# partition (/cfg). Runs hourly from cron and can be run any time
# before pulling the card for a reflash.
#
# Saved: /root, /home/cpz, dropbear keys, the whole NetworkManager config
# tree, wpa_supplicant config (legacy), hostname/hosts, everything in
# /etc/local.d and /etc/conf.d, the launcher's state
# (/var/lib/applaunch), the apk world file, plus the installed-package
# list (/cfg/pkglist.txt — re-installed automatically at the next boot
# after a reflash). Since v0.21.2 the root/cpz password lines also go to
# /cfg/shadow-users (see the v0.21.2 block below).
#
# v0.20.1 Files/Camera: the Files browser opens /home/cpz itself and
# Camera writes stills/clips to ~/Pictures/DCIM/Camera and ~/Videos/Camera,
# with its resolution setting in ~/.config/cardputerzero. All of it lives
# under /home/cpz and is therefore inside the home/cpz member below — that
# is what carries file-manager content and camera media through a reflash.
# If an app ever moves user data outside /home, add its root here or it
# will not be saved (the restore side only copies allow-listed paths).
#
# v0.19.0 NetworkManager: the whole /etc/NetworkManager tree is saved, not
# just system-connections. The keyfiles (PSK-bearing, written by the
# launcher's Settings UI or nmcli) are the user's Wi-Fi/Ethernet
# credentials, and NetworkManager.conf / conf.d/ / dispatcher.d/ carry
# global settings and hooks that nmcli cannot express (MAC policy, DNS
# backend, per-link scripts). Before this only the profile directory
# survived, so a global NM change silently died at the next reflash.
#
# v0.19.0 robustness: the member list was hardcoded and any missing path
# made busybox tar exit non-zero, which discarded the entire snapshot —
# and because the hourly job redirects to /dev/null, persistence just
# quietly stopped at the last good archive (found when /etc/wpa_supplicant
# was gone after the v0.17 NetworkManager switch). Absent optional paths
# are now skipped, and a non-zero tar exit is treated as a warning when
# the archive still validates ("file changed as we read it" is normal for
# a live /root).
#
# v0.21.2: password changes for root and cpz survive a reflash. /etc/shadow
# as a whole is deliberately NOT archived (that would resurrect stale
# system users and lock/expiry states from an older image); only the root
# and cpz lines are written to /cfg/shadow-users, 0600 like save.tar.gz.
# cpz-restore.start merges exactly those two entries and leaves every other
# account from the new image untouched.
#
# v0.21.3: /var/lib/tailscale (node key, login profiles, prefs) is saved so
# an optional Tailscale install comes back already logged in after a
# reflash. The package itself is not in the image — /etc/apk/world in pass
# B plus /cfg/pkglist.txt reinstalls it at boot — but without this member
# the node would have to be re-authenticated every time. Like the rest of
# the archive it carries secrets (the node key), so it must stay inside
# the 0600 tarball.
#
# The archive holds Wi-Fi PSKs, so it is created 0600 (umask 077); /cfg
# is readable by the cpz user and an 0644 tarball leaked every key.
# /cfg/shadow-users holds password hashes: 0600 is an on-device permission,
# not encryption — anyone who can mount the card offline can read it.

CFG=/cfg

# v0.21.6: several triggers can overlap (5-minute cron, NetworkManager
# dispatcher on connect, the shutdown hook, the launcher's Tailscale toggle).
# Two concurrent runs both write save.tar.gz.new and mv it into place, so
# serialize them: the loser exits immediately, the winner's snapshot is
# complete. The lock lives on tmpfs and disappears at boot.
LOCK=/run/cpz-save.lock
if ! mkdir "$LOCK" 2>/dev/null; then
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

if ! mountpoint $CFG >/dev/null 2>&1; then
    mkdir -p $CFG
    [ -b /dev/mmcblk0p3 ] && mount -t ext4 -o rw /dev/mmcblk0p3 $CFG 2>/dev/null
fi

mountpoint $CFG >/dev/null 2>&1 ||
    { logger -t cpz-save "no /cfg partition — nothing saved (flash with flash-cpz.sh)" 2>/dev/null
      echo "cpz-save: no /cfg partition (flash with flash-cpz.sh first)" >&2
      exit 1; }

T=$CFG/save.tar.gz.new
rm -f "$T"

# Only archive what exists: a reflashed image may have dropped an old path
# (v0.17 removed the wpa_supplicant boot path) and one missing member must
# not cost the user every other saved setting. /etc/NetworkManager stays
# first-class even when empty — the directory entry lets the restore
# recreate it 0700 if an image ever stops shipping it.
set --
for p in root home/cpz \
         etc/dropbear etc/wpa_supplicant etc/hostname etc/hosts \
         etc/local.d etc/conf.d etc/apk/world \
         etc/NetworkManager \
         var/lib/applaunch var/lib/tailscale; do
    [ -e "/$p" ] && set -- "$@" "$p"
done
[ $# -gt 0 ] || { echo "cpz-save: no save paths present" >&2; exit 1; }

umask 077
if ! tar -czpf "$T" -C / "$@" 2>/dev/null; then
    # busybox tar exits non-zero both for "file changed as we read it"
    # (archive is fine) and for real write failures. Validate instead of
    # throwing away a usable snapshot.
    tar -tzf "$T" >/dev/null 2>&1 ||
        { rm -f "$T"; echo "cpz-save: tar failed" >&2; exit 1; }
    echo "cpz-save: warning: files changed while reading; archive validated" >&2
fi
chmod 600 "$T"
mv "$T" $CFG/save.tar.gz

# v0.21.2: preserve only the two human accounts' password entries. The
# file is a 0600 sibling of save.tar.gz; restoring it is a name-keyed
# merge, so a future image can add or remove other users independently.
# Keep the old file when the write/selection fails: losing a save is worse
# than keeping yesterday's hash.
SH=$CFG/shadow-users.new
rm -f "$SH"
awk -F: 'NF == 9 && ($1 == "root" || $1 == "cpz")' /etc/shadow >"$SH" 2>/dev/null
if [ -s "$SH" ]; then
    chmod 600 "$SH"
    mv "$SH" "$CFG/shadow-users" ||
        echo "cpz-save: warning: could not write $CFG/shadow-users" >&2
else
    rm -f "$SH"
fi

apk info -q > $CFG/pkglist.txt 2>/dev/null
sync

echo "cpz-save: $(wc -c < $CFG/save.tar.gz) bytes -> $CFG/save.tar.gz"
exit 0