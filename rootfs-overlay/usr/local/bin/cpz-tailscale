#!/bin/sh
# /usr/local/bin/cpz-tailscale — Tailscale tunnel control for CPZ-Alpine.
#
# Tailscale is an OPTIONAL on-device package, not part of the image:
#
#     apk add tailscale tailscale-openrc
#     rc-update add tailscale default      # or use the launcher app
#     tailscale up
#
# The launcher's Tailscale page is compiled in but hidden until this helper
# reports "installed and logged in" (see builtin_app_registry.cpp), and it
# calls `apply on|off` through sudo -n. The boot hook
# (/etc/local.d/cpz-tailscale-boot.start) calls `boot`.
#
# Subcommands:
#   available   exit 0 when installed AND logged in (launcher visibility)
#   state       print "on"/"off" (daemon process state, for debugging)
#   ip          print the Tailscale IPv4 address (for UI display)
#   apply on|off  start/stop the daemon + sync the default runlevel.
#               Does NOT write the preference: the launcher page owns
#               /var/lib/applaunch/tailscale, so a slow helper can never
#               overwrite a newer toggle with an older state.
#   on|off      write the preference AND apply (manual/SSH use)
#   boot        reconcile the saved preference at boot (root)
#
# History / traps:
#   - The Alpine service is named "tailscale" (/etc/init.d/tailscale), not
#     "tailscaled". `rc-service tailscaled` fails with "service does not
#     exist" while the daemon is running fine.
#   - `tailscale status` cannot drive the launcher's visibility check: it
#     needs the running daemon, and the page must stay visible while the
#     tunnel is OFF. The login state lives in tailscaled.state instead.
#   - /var/lib/tailscale is 0700, so the launcher (cpz) cannot read the
#     state file itself. That is why this helper exists at all — the
#     availability decision has to be made as root.
#   - tailscaled.state is pretty-printed JSON; "_profiles" is an empty
#     string until `tailscale up` has completed. Test the VALUE, not the
#     key, or a freshly installed but logged-out node shows the app.
#   - `pgrep -x tailscaled` does NOT work on Alpine's busybox: its -x test
#     is applied to argv[0], and the init script runs "/usr/sbin/tailscaled",
#     so the exact match fails while the daemon is running. `pidof
#     tailscaled` compares the basename and works for both forms.
#   - Do not leave the service in the default runlevel when the preference
#     is OFF: OpenRC starts runlevel services before /etc/local.d runs, so
#     a boot hook alone would bring the tunnel up for the first seconds of
#     every boot. `rc-update del` is what makes OFF really mean off.
#   - After a reflash /etc/runlevels is gone (the image does not ship
#     Tailscale) while /var/lib/tailscale comes back from /cfg. `boot`
#     restores the runlevel link from the saved preference.

set -u

STATE=/var/lib/applaunch/tailscale
STATEDIR=/var/lib/tailscale
SVC=tailscale
INIT=/etc/init.d/$SVC
BIN=/usr/sbin/tailscaled

log()
{
    logger -t cpz-tailscale "$*" 2>/dev/null || true
}

installed()
{
    [ -x "$BIN" ] && [ -x "$INIT" ]
}

configured()
{
    [ -s "$STATEDIR/tailscaled.state" ] || return 1
    awk -F'"' '
        /^[[:space:]]*"_profiles"[[:space:]]*:/ { if ($4 != "") found = 1 }
        END { exit found ? 0 : 1 }
    ' "$STATEDIR/tailscaled.state" 2>/dev/null
}

running()
{
    # pidof, not `pgrep -x tailscaled`: busybox applies -x to argv[0], which
    # the init script sets to /usr/sbin/tailscaled, so the exact match fails
    # while the daemon is running. pidof compares the basename.
    pidof tailscaled >/dev/null 2>&1
}

read_pref()
{
    # No preference file yet (first boot after this feature landed, or a
    # reflash of an older snapshot): a node that is installed + configured
    # was left running by the user, so default to ON. Once the launcher
    # writes 1/0 that value is authoritative.
    if [ -f "$STATE" ]; then
        [ "$(cat "$STATE" 2>/dev/null)" = "0" ] && echo 0 || echo 1
    else
        echo 1
    fi
}

write_pref()
{
    mkdir -p /var/lib/applaunch 2>/dev/null || true
    printf '%s\n' "$1" >"$STATE" 2>/dev/null || return 1
    chown cpz:cpz "$STATE" 2>/dev/null || true
    chmod 0644 "$STATE" 2>/dev/null || true
    return 0
}

fix_owner()
{
    # The state dir holds the node key. It is 0700 in the package, but a
    # restore from /cfg recreates it from numeric ownership in an older
    # image — which may map to an unrelated account here. Force root-only
    # (plus the tailscale group when the package provides it).
    [ -d "$STATEDIR" ] || return 0
    chmod 0700 "$STATEDIR" 2>/dev/null || true
    if grep -q '^tailscale:' /etc/group 2>/dev/null; then
        chown -R root:tailscale "$STATEDIR" 2>/dev/null || true
    else
        chown -R root:root "$STATEDIR" 2>/dev/null || true
    fi
}

apply()
{
    want=${1:-}
    installed || return 3
    fix_owner
    case "$want" in
    1|on)
        rc-update add "$SVC" default >/dev/null 2>&1 || true
        if ! running; then
            rc-service "$SVC" start >/dev/null 2>&1 || {
                log "start failed"
                return 1
            }
        fi
        ;;
    0|off)
        # Remove the runlevel link FIRST: OpenRC starts default services
        # before local.d, so leaving it there would reconnect for the
        # first seconds of every boot.
        rc-update del "$SVC" default >/dev/null 2>&1 || true
        if running; then
            rc-service "$SVC" stop >/dev/null 2>&1 || {
                log "stop failed"
                return 1
            }
        fi
        ;;
    *)
        echo "usage: $0 apply on|off" >&2
        return 2
        ;;
    esac
    return 0
}

boot()
{
    want=$(read_pref)
    if ! installed; then
        # A reflash restores /etc/apk/world + /cfg/pkglist.txt, and
        # cpz-wifi.start reinstalls the packages in the background. Wait
        # for the binary (bounded) instead of blocking the boot or losing
        # the saved ON state.
        (
            i=0
            while [ "$i" -lt 90 ] && ! installed; do
                sleep 2
                i=$((i + 1))
            done
            if installed; then
                apply "$(read_pref)"
            fi
        ) >/dev/null 2>&1 &
        return 0
    fi
    apply "$want"
}

case "${1:-}" in
available)
    installed && configured
    ;;
state)
    if running; then echo on; else echo off; fi
    ;;
apply)
    apply "${2:-}"
    ;;
on)
    write_pref 1 && apply on
    ;;
off)
    write_pref 0 && apply off
    ;;
ip)
    installed || exit 1
    tailscale ip -4 2>/dev/null || true
    ;;
boot)
    boot
    ;;
*)
    echo "usage: $0 available|state|apply on|off|on|off|ip|boot" >&2
    exit 2
    ;;
esac
