#!/bin/sh
# /usr/local/bin/cpz-desktop — CPZ-Alpine on-demand HDMI session
#
# docs/05 contract: at boot NOTHING graphical runs and HDMI stays dark.
# This command is the only way a session starts (the launcher's HDMI app
# calls it, and an opt-in udev hotplug hook may too).
#
#   cpz-desktop start   seatd up -> sway+waybar on HDMI (as user cpz),
#                       HDMI audio becomes the default ALSA card
#   cpz-desktop stop    sway down, seatd down, ALSA default back to the
#                       internal es8389 — prints free -m before/after
#   cpz-desktop status
#
# v0.18.0: works for BOTH root (boot hook) and cpz (the launcher runs as
# cpz now). The few root-only steps go through passwordless sudo when
# invoked unprivileged; the sway session itself always runs as cpz.
#
# Earlier field fixes kept here (do not regress):
#   1. seatd must be READY (socket present) before sway starts. OpenRC
#      returns before /run/seatd.sock exists and libseat then falls
#      through to its logind backend and dies ("No backend was able to
#      open a seat"). We wait for the socket and force
#      LIBSEAT_BACKEND=seatd.
#   2. a stale /run/seatd.pid from a zombie seatd blocks starts
#      ("/usr/bin/seatd is already running"); detect the zombie via
#      /proc/<pid>/stat and clear the pidfile.
#   3. sway.config shipped 0600 root-only -> the cpz session could not
#      read its own config. Build normalizes 0644 (rootfs-configure).
#   4. setsid detaches the session from the calling terminal's process
#      group (started from the launcher CLI/HDMI app, a plain `&` left
#      children behind when that shell exited).

CMD=${1:-status}
ME_UID=$(id -u)

ram_used() { free -m | awk "/^Mem:/ {print \$3}"; }

# run a privileged helper as root, via sudo when we are not root
as_root() {
    if [ "$ME_UID" = 0 ]; then
        "$@"
    else
        sudo -n "$@"
    fi
}

seatd_pid_alive_or_zombie() {
    pid=$(cat /run/seatd.pid 2>/dev/null) || return 0
    [ -n "$pid" ] || return 0
    [ -d "/proc/$pid" ] || return 0
    state=$(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null)
    case "$state" in
        Z) echo zombie ;;
        *) echo alive ;;
    esac
}

ensure_seatd() {
    if [ -S /run/seatd.sock ]; then
        return 0
    fi
    case "$(seatd_pid_alive_or_zombie)" in
        zombie)
            echo "cpz-desktop: clearing zombie seatd pidfile (/run/seatd.pid)"
            as_root rm -f /run/seatd.pid
            ;;
        alive)
            : # live daemon without a socket: restart it
            ;;
    esac
    as_root rc-service seatd stop >/dev/null 2>&1
    as_root rc-service seatd zap >/dev/null 2>&1
    as_root rc-service seatd start >/dev/null 2>&1
    i=0
    while [ ! -S /run/seatd.sock ] && [ $i -lt 40 ]; do
        sleep 0.25
        i=$((i + 1))
    done
    [ -S /run/seatd.sock ]
}

start_session() {
    if pgrep -x sway >/dev/null 2>&1; then
        echo "cpz-desktop: session already running"
        exit 0
    fi
    BEFORE=$(ram_used)

    if ! ensure_seatd; then
        echo "cpz-desktop: seatd socket did not appear — cannot start a session"
        pid=$(cat /run/seatd.pid 2>/dev/null)
        [ -n "$pid" ] && [ -d "/proc/$pid" ] &&
            echo "             seatd pid $pid state: $(awk '{print $3}' /proc/$pid/stat)"
        exit 1
    fi

    # Wayland runtime dir for the unprivileged session user
    as_root mkdir -p /run/user/1000
    as_root chown cpz:cpz /run/user/1000
    as_root chmod 700 /run/user/1000

    # HDMI audio becomes the default card while the session is up
    as_root ln -sf /usr/share/alsa/alsa.conf.d/20-vc4hdmi.conf /etc/asound.conf 2>/dev/null

    # The session. As root we enter cpz's account; as cpz we run directly
    # (a `su - cpz` from cpz would prompt for a password).
    #
    # XKB_DEFAULT_LAYOUT=cpz + XKB_DEFAULT_OPTIONS=cpz:sym: seed the
    # initial seat keymap. The seat keymap is built from the default
    # xkb keymap, NOT from the per-device input blocks, so both the
    # layout and the option must be in the environment or clients keep
    # the US media keys (Sym+1 -> XF86Tools). cpz includes us(basic), so
    # external keyboards still type US; Alt-as-Super stays scoped to
    # 1:1:tca8418c in sway.config.
    if [ "$ME_UID" = 0 ]; then
        LIBSEAT_BACKEND=seatd setsid su - cpz -c \
            "LIBSEAT_BACKEND=seatd XKB_DEFAULT_LAYOUT=cpz XKB_DEFAULT_OPTIONS=cpz:sym XDG_RUNTIME_DIR=/run/user/1000 dbus-run-session sway -c /etc/cpz/sway.config" \
            >/dev/null 2>&1 </dev/null &
    else
        LIBSEAT_BACKEND=seatd XKB_DEFAULT_LAYOUT=cpz XKB_DEFAULT_OPTIONS=cpz:sym setsid dbus-run-session sway -c /etc/cpz/sway.config \
            >/dev/null 2>&1 </dev/null &
    fi

    i=0
    while [ $i -lt 16 ]; do
        sleep 0.5
        pgrep -x sway >/dev/null 2>&1 && break
        i=$((i + 1))
    done
    if pgrep -x sway >/dev/null 2>&1; then
        echo "cpz-desktop: session up (sway as $(pgrep -x sway | head -1))"
        echo "RAM: ${BEFORE} MiB -> $(ram_used) MiB used"
    else
        echo "cpz-desktop: sway did NOT start — check: hdmi plugged? seatd socket?"
        echo "             run with stderr visible:"
        echo "             su - cpz -c \"LIBSEAT_BACKEND=seatd XDG_RUNTIME_DIR=/run/user/1000 sway\""
        exit 1
    fi
}

stop_session() {
    BEFORE=$(ram_used)
    pkill -x sway 2>/dev/null
    pkill -x waybar 2>/dev/null
    sleep 1
    as_root rc-service seatd stop >/dev/null 2>&1
    as_root rc-service seatd zap >/dev/null 2>&1
    as_root rm -f /etc/asound.conf
    echo "cpz-desktop: stopped. RAM: ${BEFORE} MiB -> $(ram_used) MiB used"
    echo "             (design gate: within +10 MiB of pre-session)"
}

case "$CMD" in
    start) start_session ;;
    stop)  stop_session ;;
    status)
        if pgrep -x sway >/dev/null 2>&1; then
            echo "running (sway pid $(pgrep -x sway | head -1))"
        else
            echo "stopped"
        fi
        ;;
    *) echo "usage: cpz-desktop start|stop|status"; exit 1 ;;
esac
