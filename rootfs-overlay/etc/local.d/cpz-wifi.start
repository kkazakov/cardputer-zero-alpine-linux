#!/bin/sh
# /etc/local.d/cpz-wifi.start — CPZ-Alpine
#
# Something soft-blocks wlan0 (and hci0) at every boot: cfg80211 then
# refuses to bring the interface up. NetworkManager would eventually
# unblock it too, but doing it here keeps the first association attempt
# from failing.
#
# v0.14: NetworkManager owns wlan0/eth0 now (the launcher's Wi-Fi
# settings drive nmcli; NM spawns its own wpa_supplicant instance). The
# standalone `wpa_supplicant` and `networking` OpenRC services are no
# longer in any runlevel, and this script no longer restarts/ifups
# anything — nmcli connection profiles (baked in at build time from
# build/wifi-secret, restored from /cfg by cpz-restore, or joined
# through the launcher UI) are all NM needs.
#
# Dead ends (do not re-add):
#   v0.10.1..v0.13: `rc-service wpa_supplicant restart` + `ifup wlan0`
#   here — that was the ifupdown-ng path; with NM running it would
#   fight the manager over the same interface.
#
# After the link is up, best-effort reinstall of user packages whose
# list was restored from /cfg (apk add of already-installed packages is
# a quick no-op, so running this every boot is fine).

rfkill unblock all 2>/dev/null

# user packages from the persistence partition (background, needs net).
# v0.21.10: /cfg/world is the explicit package list (tailscale, ...).
# pkglist.txt (every installed package) is the fallback for cards saved by
# older images. Report progress in /run/cpz-pkg.status so the launcher can
# show it: pending N -> installing N -> ok|failed.
PKG=/cfg/world
[ -s "$PKG" ] || PKG=/cfg/pkglist.txt
if [ -s "$PKG" ] && mountpoint /cfg >/dev/null 2>&1; then
    (
        STATUS=/run/cpz-pkg.status
        LOG=/var/log/cpz-pkg.log

        # v0.21.10: a custom repository config and local .apk files are part
        # of the user's package state too. Restore the repo list first, then
        # install /cfg/apk/*.apk (out-of-repository packages), then the world.
         [ -s /cfg/repositories ] && cp /cfg/repositories /etc/apk/repositories 2>/dev/null
        [ -d /cfg/apk-keys ] && cp -p /cfg/apk-keys/* /etc/apk/keys/ 2>/dev/null

        n=0
        for p in $(cat "$PKG"); do
            apk info -e "$p" >/dev/null 2>&1 || n=$((n + 1))
        done
        localn=0
        for f in /cfg/apk/*.apk; do
            [ -f "$f" ] && localn=$((localn + 1))
        done
        echo "pending $((n + localn))" > "$STATUS"
        echo "$(date -u) pending $n repo + $localn local package(s)" >> "$LOG"

        i=0
        while [ "$i" -lt 18 ]; do
            echo "installing $((n + localn))" > "$STATUS"
            for f in /cfg/apk/*.apk; do
                [ -f "$f" ] || continue
                apk add --allow-untrusted "$f" >>"$LOG" 2>&1 || true
            done
            if [ "$n" -eq 0 ]; then break; fi
            if apk add --no-cache $(cat "$PKG") >>"$LOG" 2>&1; then
                n=0
                break
            fi
            sleep 10
            i=$((i + 1))
        done
        if [ "$n" -eq 0 ]; then
            echo "ok" > "$STATUS"
        else
            echo "failed" > "$STATUS"
        fi
        echo "$(date -u) $(cat "$STATUS" 2>/dev/null)" >> "$LOG"
    ) &
fi

exit 0
