#!/bin/sh
# /etc/local.d/cpz-wifi.start — CPZ-Alpine
#
# Something soft-blocks wlan0 (and hci0) at every boot: cfg80211 then
# refuses to bring the interface up. NetworkManager would eventually
# unblock it too, but doing it here keeps the first association attempt
# from failing.
#
# v0.14: NetworkManager owns wlan0/eth0 now (the launcher's Wi-Fi
# settings drive nmcli; NM spawns its own wpa_supplicant instance). The
# standalone `wpa_supplicant` and `networking` OpenRC services are no
# longer in any runlevel, and this script no longer restarts/ifups
# anything — nmcli connection profiles (baked in at build time from
# build/wifi-secret, restored from /cfg by cpz-restore, or joined
# through the launcher UI) are all NM needs.
#
# Dead ends (do not re-add):
#   v0.10.1..v0.13: `rc-service wpa_supplicant restart` + `ifup wlan0`
#   here — that was the ifupdown-ng path; with NM running it would
#   fight the manager over the same interface.
#
# After the link is up, best-effort reinstall of user packages whose
# list was restored from /cfg (apk add of already-installed packages is
# a quick no-op, so running this every boot is fine).

rfkill unblock all 2>/dev/null

# user packages from the persistence partition (background, needs net)
if [ -s /cfg/pkglist.txt ] && [ -d /cfg ]; then
    ( apk add --no-cache $(cat /cfg/pkglist.txt) >/dev/null 2>&1 ) &
fi

exit 0
