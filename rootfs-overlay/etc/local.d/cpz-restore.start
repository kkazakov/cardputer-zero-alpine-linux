#!/bin/sh
# /etc/local.d/cpz-restore.start — CPZ-Alpine persistence layer
#
# /cfg is the CPZDATA partition (ext4, /dev/mmcblk0p3 at the fixed 4 GiB
# offset, created by flash-cpz.sh — survives every reflash). cpz-save
# (hourly via cron + on demand) writes /cfg/save.tar.gz; this script
# restores it at boot.
#
# Conflict policy (important — old archives must not resurrect stale
# build files into new images):
#   pass A, archive WINS: user-owned config (/root, /home/cpz, dropbear
#     keys, NM connection profiles, wpa conf, hostname/hosts, launcher
#     settings) — the user's data is authoritative
#   pass B, image WINS: /etc/local.d, /etc/conf.d, /etc/apk, and the
#     global NetworkManager config (NetworkManager.conf, conf.d,
#     dispatcher.d) — merged in only where the new image does not ship its
#     own file, so new build versions are never overwritten, but
#     user-added scripts/keys and the apk world list still come back.
#
# NetworkManager profiles (/etc/NetworkManager/system-connections)
# carry Wi-Fi credentials joined through the launcher's Settings UI;
# restoring them user-is-king keeps networks across reflashes.
#
# v0.19.0 history (this file had three compounding bugs; all field-visible
# as "my Wi-Fi came back on the old network" / "my NM config vanished"):
#   1. pass A was flagged -xzpkf. The k hides inside the cluster and is
#      --keep-old-files, so every file the new image already shipped was
#      kept and the archived copy skipped. The "archive wins" promise was
#      false: an on-device hostname/hosts/NM keyfile edit never came back,
#      and an archived profile whose filename collided with a baked one
#      (cpz-wifi.nmconnection) was dropped, leaving stale build PSKs.
#   2. busybox tar ABORTS the whole extraction at the first file it cannot
#      replace (a busy or immutable /etc/hostname is enough), silently
#      dropping every later member — including the NM profiles.
#   3. pass B used tar -k as well, and the first existing file in
#      /etc/local.d killed the run, so user-added scripts, conf.d keys and
#      dispatcher hooks were never restored either.
# The fix is to extract once into an empty staging dir (no conflicts are
# possible there, so the extraction cannot abort) and then merge each
# allow-listed path explicitly — pass A overwrites, pass B does not.
# Nothing outside the two lists is ever copied back, so a stale or hostile
# archive cannot drop files into the running rootfs.
#
# v0.19.0: the global NM config used to be left out entirely, so a
# NetworkManager.conf / conf.d / dispatcher.d tweak was lost at the next
# reflash even though the profiles themselves came back.
#
# v0.20.0: Files and Camera keep user content under /home/cpz (the Files
# browser itself opens that tree, plus ~/Pictures/DCIM/Camera,
# ~/Videos/Camera and ~/.config/cardputerzero). The pass A home/cpz merge
# below restores all of it, with archive-wins semantics, after the new
# image's empty home skeleton has been laid down.
#
# v0.21.2: root/cpz password changes are restored from /cfg/shadow-users
# (written by cpz-save) by replacing just those two /etc/shadow lines.
# This is a name-keyed merge after pass A/B, not a whole-file restore:
# users the new image ships (or drops) stay under the image's control,
# and a malformed/absent file leaves the image's passwords in place.

CFG=/cfg
A=$CFG/save.tar.gz

# mount the data partition if present (raw-dd flashes have no p3 — skip)
if [ -b /dev/mmcblk0p3 ] && ! mountpoint $CFG >/dev/null 2>&1; then
    mkdir -p $CFG
    mount -t ext4 -o rw /dev/mmcblk0p3 $CFG 2>/dev/null
fi

mountpoint $CFG >/dev/null 2>&1 || exit 0
[ -s "$A" ] || exit 0
tar -tzf "$A" >/dev/null 2>&1 ||
    { echo "cpz-restore: archive unreadable, skipping" >&2; exit 0; }

PASS_A="root home/cpz etc/dropbear etc/wpa_supplicant etc/hostname \
etc/hosts etc/NetworkManager/system-connections var/lib/applaunch"
PASS_B="etc/local.d etc/conf.d etc/apk/world \
etc/NetworkManager/NetworkManager.conf \
etc/NetworkManager/conf.d etc/NetworkManager/dispatcher.d"

STAGE=$(mktemp -d /tmp/cpz-restore.XXXXXX 2>/dev/null) || STAGE=
if [ -z "$STAGE" ]; then
    echo "cpz-restore: no temp space, persistence skipped" >&2
    exit 0
fi
tar -xzpf "$A" -C "$STAGE" 2>/dev/null || true

# pass A — archive wins (overwrite without asking)
for p in $PASS_A; do
    [ -e "$STAGE/$p" ] || continue
    if [ -d "$STAGE/$p" ]; then
        mkdir -p "/$p" 2>/dev/null
        cp -a "$STAGE/$p/." "/$p/" 2>/dev/null || true
    else
        cp -p "$STAGE/$p" "/$p" 2>/dev/null || true
    fi
done

# restored NM profiles are root-only (they contain PSKs)
chmod -R go-rwx /etc/NetworkManager/system-connections 2>/dev/null

# v0.18.1: the launcher (and its HDMI app) runs as cpz and writes
# config.json / hdmi-desktop here. The archive above is created by root,
# so the extracted files come back root-owned and the app could no longer
# persist its state (silent Off after a reflash). Restore cpz ownership.
chown -R cpz:cpz /var/lib/applaunch 2>/dev/null

# pass B — image wins: create only paths the new image does not ship
for p in $PASS_B; do
    [ -e "$STAGE/$p" ] || continue
    (
        cd "$STAGE" || exit 0
        find "./$p" -type d -exec \
            sh -c 'mkdir -p "/${1#./}"' sh {} \; 2>/dev/null
        find "./$p" -type f -exec \
            sh -c 'd="/${1#./}"; [ -e "$d" ] || cp -p "$1" "$d"' sh {} \; 2>/dev/null
        find "./$p" -type l -exec \
            sh -c 'd="/${1#./}"; [ -e "$d" ] || ln -s "$(readlink "$1")" "$d"' sh {} \; 2>/dev/null
    )
done

# v0.21.2: merge the saved root/cpz password lines into the image's
# /etc/shadow. Only 9-field lines with a real hash/lock marker are
# accepted; other accounts are left exactly as the image ships them.
# Write a temp file (0600 root:root) and rename, so a crash cannot leave a
# half-written shadow file and PAM never sees a partial line.
SH=$CFG/shadow-users
if [ -f "$SH" ] && [ ! -L "$SH" ] && [ -s "$SH" ] && [ -f /etc/shadow ]; then
    TMP=$(mktemp /etc/shadow.cpz.XXXXXX) || TMP=
    if [ -n "$TMP" ]; then
        chmod 600 "$TMP"
        if awk -F: '
            NR == FNR {
                if (NF == 9 && ($1 == "root" || $1 == "cpz") && $2 ~ /^[$!*]/)
                    saved[$1] = $0
                next
            }
            {
                if ($1 in saved) { print saved[$1]; next }
                print
            }
        ' "$SH" /etc/shadow > "$TMP" && [ -s "$TMP" ]; then
            chown 0:0 "$TMP" 2>/dev/null || true
            chmod 600 "$TMP"
            if mv "$TMP" /etc/shadow; then
                logger -t cpz-restore "restored root/cpz password hashes" 2>/dev/null || true
            else
                rm -f "$TMP"
                logger -t cpz-restore "shadow rename failed, keeping image passwords" 2>/dev/null || true
            fi
        else
            rm -f "$TMP"
            logger -t cpz-restore "shadow merge failed, keeping image passwords" 2>/dev/null || true
        fi
    fi
fi

rm -rf "$STAGE"

# dropbear host keys / authorized_keys may have just changed — restart
# it so the running daemon matches the restored files
rc-service dropbear restart >/dev/null 2>&1

# same for NetworkManager: re-read restored connection profiles.
# v0.19.0: Alpine's /etc/init.d/networkmanager defines only depend() — it
# has no reload() function, so the old `rc-service networkmanager reload`
# always failed and the fallback tore the daemon down on every boot.
# `nmcli connection reload` is the supported way to make NM re-read every
# keyfile on disk (SIGUSR1) without dropping connections. Only poke NM if
# it is actually up: when it starts later it reads the restored files
# itself, and forcing a restart at that point just races dbus.
if nmcli -t general status >/dev/null 2>&1; then
    nmcli connection reload >/dev/null 2>&1 ||
        rc-service networkmanager restart >/dev/null 2>&1
fi

NMPROF=$(ls /etc/NetworkManager/system-connections 2>/dev/null | wc -l)
logger -t cpz-restore \
    "restored snapshot: $NMPROF NetworkManager profile(s) available" \
    2>/dev/null || true

exit 0