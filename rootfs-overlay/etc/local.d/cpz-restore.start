#!/bin/sh
# /etc/local.d/cpz-restore.start — CPZ-Alpine persistence layer
#
# /cfg is the CPZDATA partition (ext4, /dev/mmcblk0p3 at the fixed 4 GiB
# offset, created by flash-cpz.sh — survives every reflash). cpz-save
# (hourly via cron + on demand) writes /cfg/save.tar.gz; this script
# restores it at boot.
#
# Conflict policy (important — old archives must not resurrect stale
# build files into new images):
#   pass A, archive WINS: user-owned config (/root, /home/cpz, dropbear
#     keys, wpa conf, hostname/hosts) — the user's data is authoritative
#   pass B, image WINS: /etc/local.d, /etc/conf.d, /etc/apk — restored
#     only where the new image does not ship its own file (-k), so new
#     build versions are never overwritten, but user-added scripts and
#     the apk world list still come back.
#
# Ordering: runs before cpz-wifi.start (alphabetical), so restored wifi
# config is in place before the bring-up script restarts wpa_supplicant.

CFG=/cfg
A=$CFG/save.tar.gz

# mount the data partition if present (raw-dd flashes have no p3 — skip)
if [ -b /dev/mmcblk0p3 ] && ! mountpoint $CFG >/dev/null 2>&1; then
    mkdir -p $CFG
    mount -t ext4 -o rw /dev/mmcblk0p3 $CFG 2>/dev/null
fi

mountpoint $CFG >/dev/null 2>&1 || exit 0
[ -s "$A" ] || exit 0
tar -tzf "$A" >/dev/null 2>&1 ||
    { echo "cpz-restore: archive unreadable, skipping" >&2; exit 0; }

# pass A — user-is-king
tar -xzpkf "$A" -C / \
    root home/cpz etc/dropbear etc/wpa_supplicant etc/hostname etc/hosts \
    2>/dev/null

# pass B — additive (never overwrite a file the new image ships)
tar -xzpkf "$A" -k -C / \
    etc/local.d etc/conf.d etc/apk/world \
    2>/dev/null

# dropbear host keys / authorized_keys may have just changed — restart
# it so the running daemon matches the restored files
rc-service dropbear restart >/dev/null 2>&1

exit 0