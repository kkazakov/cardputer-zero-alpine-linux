# /etc/modules — CPZ-Alpine device bring-up at boot
# Loaded by OpenRC's `modules` service (boot runlevel), in order.
# Dependencies (fbtft, backlight, matrix-keymap, regmap, iio) resolve
# automatically via modules.dep from the stock module tree.
#
# Kernel-builtin already: ext4, full MMC/SD stack, dwc2 (USB).
# Auto-probed via DT/udev coldplug: vc4 (HDMI KMS), brcmfmac (Wi-Fi).

spi_bcm2835
pwm_bcm2835
fbtft
st7789v_m5stack
pwm_bl_m5stack
i2c_bcm2835
tca8418_keypad_m5stack
es8389_m5stack
bq27xxx_battery_i2c
bmi270_i2c
m5ioe1
# v0.6: neither of these has a udev autoload path that fires on this
# board — i2c-dev has no modalias at all, and the wifi@1 coldplug never
# reached brcmfmac. Force-load both early.
i2c-dev
brcmfmac
# v0.9: CDC-ACM serial gadget on USB-C — binds to the dwc2 UDC and
# creates ttyGS0 (getty runs on it from inittab).
g_serial
# v0.12: SR9900 ethernet via patched r8152 (usb 0x0fe6:0x9900, ID
# added per mainline lore.kernel.org patch). Harmless with no device.
r8152
