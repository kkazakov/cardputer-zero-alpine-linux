# /etc/cpz/sway.config — CPZ-Alpine on-demand HDMI session
#
# The internal 320x170 LCD is a legacy fbdev device (fbtft), NOT a KMS
# output — sway's DRM backend only ever sees the vc4 HDMI connector.
# The LCD console is therefore untouched by design: it lives on tty1
# forever; this session lives on HDMI only.
#
# v0.19.0: the internal TCA8418 keypad is a first-class Sway keyboard.
# Sway keeps Mod4 = Super. The physical Alt key is remapped to Super_L
# *for this session and this device only* (altwin:swap_lalt_lwin), so
# every stock Mod4 binding below works from the internal keyboard.
# An external USB keyboard is untouched: real Super, real Alt, us layout.
#
# The Wayland seat has ONE keymap shared by every client. XKB's default
# rules append inet(evdev), which redefines the internal SYM codes as
# media keys; `cpz:sym` is an XKB option applied after inet, so it wins.
# The option is set for all keyboards because the seat keymap is shared;
# the cpz layout includes us(basic), so external keyboards still type US.
# Alt-as-Super remains scoped to the internal device.
#
# While this session runs, the LCD launcher pauses its own keypad input
# and shows "HDMI LOCKED". Hold ESC for 2 s on the LCD to stop the
# session and get the LCD back; Mod+Shift+E does the same from Sway.

# Explicit and honest about the one output there is:
output HDMI-A-1 mode 1920x1080@60Hz

# Super key = the USB keyboard's Mod4; on the CPZ internal keyboard
# there is none, so the input block below makes its Alt key act as Super.
set $mod Mod4

# All keyboards: cpz = US basics + the SYM option applied after inet.
# This keeps the shared seat keymap correct for the internal keypad;
# external keyboards still type US (cpz includes us(basic)).
input * {
    xkb_layout cpz
    xkb_options cpz:sym
}

# Internal keypad only: add Alt -> Super_L. XKB options are a
# COMMA-separated list: "cpz:sym altwin:..." is one unknown option and
# is silently dropped (that made both the SYM keys and Alt-as-Super
# disappear). Include both so this works whether sway merges or
# replaces the global option list.
input "1:1:tca8418c" {
    xkb_options "cpz:sym,altwin:swap_lalt_lwin"
}

# --- core actions (deliberately minimal; layouts/scratchpad opt-in) ---
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
# Stop the whole desktop, not just sway: this is also the LCD unlock path
# (the launcher sees sway disappear and re-enables its own keypad).
bindsym $mod+Shift+e exec "/usr/local/bin/cpz-desktop stop"
bindsym $mod+Shift+c reload
bindsym $mod+f fullscreen toggle

# tiling / floating focus
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle

# workspaces (0..9, matching the stock Sway list)
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 0
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 0
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# Focus / move. The internal arrow keys are Fn+Z/X/C/F
# (Left/Down/Right/Up, verified from the live DT keymap2), so the
# physical chords are Mod+Fn+Z, Mod+Fn+X, Mod+Fn+C, Mod+Fn+F.
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# App launcher: Super+d (bemenu — the lightest wayland-native launcher
# in the Alpine repos; fuzzel is absent from this mirror)
bindsym $mod+d exec bemenu-run

# Status bar with clock/battery/network — the "very light desktop" part
exec waybar

# Terminal on session start: foot only (tilix is opt-in)
exec foot

# No wallpaper daemon: black background costs 0 MiB and looks intentional.