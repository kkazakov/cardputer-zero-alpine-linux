# /etc/cpz/sway.config — CPZ-Alpine on-demand HDMI session
#
# The internal 320x170 LCD is a legacy fbdev device (fbtft), NOT a KMS
# output — sway's DRM backend only ever sees the vc4 HDMI connector.
# The LCD console is therefore untouched by design: it lives on tty1
# forever; this session lives on HDMI only.

# Explicit and honest about the one output there is:
output HDMI-A-1 mode 1920x1080@60Hz

# Super key = the USB keyboard's Mod4; on the CPZ internal keyboard
# there is none, but this session is meant for real keyboards.
set $mod Mod4

# Kill focused window: Super+Shift+q
bindsym $mod+Shift+q kill

# Exit sway itself: Super+Shift+e (logs out of the HDMI session)
bindsym $mod+Shift+e exit

# Default terminal: foot (small, instant). Super+Enter.
set $term foot
bindsym $mod+Return exec $term

# Tilix is INSTALLED but never started automatically — launch it from
# the app menu (Super+d) or bind your own key, e.g.:
#   bindsym $mod+t exec tilix

# App launcher: Super+d (bemenu — the lightest wayland-native launcher
# in the Alpine repos; fuzzel is absent from this mirror)
bindsym $mod+d exec bemenu-run

# Status bar with clock/battery/network — the "very light desktop" part
exec waybar

# Terminal on session start: foot only (tilix is opt-in)
exec foot

# No wallpaper daemon: black background costs 0 MiB and looks intentional.