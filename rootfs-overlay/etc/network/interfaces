# /etc/network/interfaces — CPZ-Alpine
#
# v0.14: NetworkManager owns all device configuration (the launcher's
# Wi-Fi settings drive nmcli; NM also brings up wired eth0 with DHCP).
# This file intentionally contains only the loopback; putting wlan0/eth0
# here would risk a second manager fighting NM for the same interfaces.
#
# Wi-Fi credentials live as NM keyfile profiles:
#   /etc/NetworkManager/system-connections/*.nmconnection
# baked at build time from build/wifi-secret, restored from /cfg by
# cpz-restore, or joined through the launcher's Settings → Wi-Fi UI.

auto lo
iface lo inet loopback
