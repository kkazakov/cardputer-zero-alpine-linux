		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 'ALC OFF'
			item.1 'ADCR ALC ON'
			item.2 'ADCL ALC ON'
			item.3 'ADCL & ADCL ALC ON'
		}
	}
	control.8 {
		iface MIXER
		name 'ALC Capture Target Level'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 15'
			dbmin -3200
			dbmax -200
			dbvalue.0 -3200
		}
	}
