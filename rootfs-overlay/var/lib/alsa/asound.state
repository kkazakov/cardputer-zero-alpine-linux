state.ES8389Audio {
	control.1 {
		iface MIXER
		name 'ADCL Capture Volume'
		value 191
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 255'
			dbmin -9550
			dbmax 3200
			dbvalue.0 0
		}
	}
	control.2 {
		iface MIXER
		name 'ADCR Capture Volume'
		value 191
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 255'
			dbmin -9550
			dbmax 3200
			dbvalue.0 0
		}
	}
	control.3 {
		iface MIXER
		name 'ADCL PGA Volume'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 14'
			dbmin 0
			dbmax 4200
			dbvalue.0 0
		}
	}
	control.4 {
		iface MIXER
		name 'ADCR PGA Volume'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 14'
			dbmin 0
			dbmax 4200
			dbvalue.0 0
		}
	}
	control.5 {
		iface MIXER
		name 'PGAL Select'
		value DifferentialL
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 DifferentialL
			item.1 'Line 1P'
			item.2 'Line 2P'
		}
	}
	control.6 {
		iface MIXER
		name 'PGAR Select'
		value DifferentialR
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 DifferentialR
			item.1 'Line 2N'
			item.2 'Line 1N'
		}
	}
	control.7 {
		iface MIXER
		name 'ALC Capture Switch'
