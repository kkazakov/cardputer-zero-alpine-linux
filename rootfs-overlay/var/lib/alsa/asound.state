		iface MIXER
		name 'ALC Capture Max Gain'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 15'
			dbmin -3200
			dbmax -200
			dbvalue.0 -3200
		}
	}
	control.10 {
		iface MIXER
		name 'ADC Ramp Rate'
		value '0.125db/1  LRCK'
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 '0.125db/1  LRCK'
			item.1 '0.125db/4  LRCK'
			item.2 '0.125db/8  LRCK'
			item.3 '0.125db/16  LRCK'
			item.4 '0.125db/32  LRCK'
			item.5 '0.125db/64  LRCK'
			item.6 '0.125db/128  LRCK'
			item.7 '0.125db/256  LRCK'
			item.8 '0.125db/512  LRCK'
			item.9 '0.125db/1024  LRCK'
			item.10 '0.125db/2048  LRCK'
			item.11 '0.125db/4096  LRCK'
			item.12 '0.125db/8192  LRCK'
			item.13 '0.125db/16384  LRCK'
			item.14 '0.125db/32768  LRCK'
			item.15 '0.125db/65536  LRCK'
		}
	}
	control.11 {
		iface MIXER
		name 'ALC Capture Winsize'
		value '2 LRCK'
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 '2 LRCK'
			item.1 '4  LRCK'
			item.2 '8  LRCK'
			item.3 '16  LRCK'
			item.4 '32  LRCK'
